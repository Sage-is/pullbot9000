# Pullbot AppDir Instance Configuration
#
# Each AppDir has its own .env with instance-specific settings.
# Shared defaults come from the main repo's .env.example.
#
# REQUIRED — must be unique per instance:

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TUNNEL_ID=

# Absolute path — resolves correctly when AppRun cd's to $PULLBOT_HOME
DATABASE_URL=sqlite:////home/replicant/INSTANCE_NAME.app/data/bot.db

# INSTANCE SETTINGS:

BACKEND=claude
APPROVED_DIRECTORY=/path/to/your/projects
ALLOWED_USERS=

# API server — 0 means OS-assigned (recommended for AppDir instances)
API_SERVER_PORT=0
ENABLE_API_SERVER=true

# OpenCode sidecar (only when BACKEND=opencode)
OPENCODE_SERVER_PORT=4096

# Security
DISABLE_SECURITY_PATTERNS=false
DISABLE_TOOL_VALIDATION=false

# See the main repo's .env.example for all available settings.
